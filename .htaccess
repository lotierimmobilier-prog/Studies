# Capendu en bref : protections de base (Hostinger / LiteSpeed)
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Fichiers cachés et documents de travail non publics
<FilesMatch "(^\.(?!htaccess$)|\.md$|\.sample\.php$)">
  Require all denied
</FilesMatch>

# Cache : CSS et JS rechargés au plus tard toutes les heures (les images et polices restent en cache long)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Mesure d'audience anonyme : les pages publiques passent par un petit script qui compte la visite puis sert le fichier (sans cookie).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ annonces/t.php?f=index [L]
  RewriteRule ^index\.html$ annonces/t.php?f=index [L]
  RewriteRule ^devenir-partenaire\.html$ annonces/t.php?f=devenir [L]
  RewriteRule ^qui-est-derriere\.html$ /a-propos.html [R=301,L]
  RewriteRule ^a-propos\.html$ annonces/t.php?f=qui [L]
  RewriteRule ^conditions\.html$ annonces/t.php?f=conditions [L]
  RewriteRule ^capendu-histoire\.html$ annonces/t.php?f=histoire [L]
  RewriteRule ^liens\.html$ annonces/t.php?f=liens [L]
  RewriteRule ^mcp$ annonces/mcp.php [L]
  RewriteRule ^rgpd\.html$ annonces/t.php?f=rgpd [L]
  RewriteRule ^llms\.txt$ annonces/t.php?f=llms [L]
  RewriteRule ^robots\.txt$ annonces/t.php?f=robots [L]
  RewriteRule ^sitemap\.xml$ annonces/t.php?f=sitemap [L]
</IfModule>

# Carte du serveur MCP : lisible par n'importe quel agent
<IfModule mod_headers.c>
  <FilesMatch "^server-card\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
