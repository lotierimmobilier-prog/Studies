{
  "name": "portail-voyageurs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portail pour les voyageurs Airbnb : tutoriels vidéo, accès à la maison, tourisme et infos de séjour, avec connexion par séjour",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
